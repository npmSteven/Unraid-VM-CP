UNRAID_IP=
UNRAID_IS_HTTPS=
UNRAID_USERNAME=
UNRAID_PASSWORD=
JWT_SECRET=

# Server
# SERVER_PORT=8787
# SERVE_FRONTEND=true            # Serve frontend static files from Express (single-port mode)
# FRONTEND_DIST_PATH=../frontend/dist

# Proxy
# TRUST_PROXY=false              # true, 1 (number of hops), or "10.0.0.0/8,loopback" (CIDR/subnet string)

# CORS
# CORS_ORIGIN=*
