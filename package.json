{
  "name": "unraid-vm-cp",
  "version": "1.1.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:backend": "cd backend && bun --watch src/server.ts",
    "dev:frontend": "cd frontend && bunx --bun vite",
    "build:frontend": "cd frontend && bun install && bun run build",
    "build:all": "bun run build:frontend",
    "start:backend": "cd backend && bun run src/server.ts",
    "start:frontend": "cd frontend && bun run http",
    "start:all": "concurrently --kill-others \"bun run start:backend\" \"bun run start:frontend\"",
    "start:prod": "bun run start:backend"
  },
  "keywords": [],
  "author": "",
